# HP proprietary package and anything extracted from it — NEVER commit
vendor/

# Python virtualenv
.venv/
venv/
__pycache__/
*.pyc

# Large raw captures (commit small/representative ones deliberately with -f)
captures/*.pcap
captures/*.pcapng
captures/*.usbmon
captures/*.bin.raw

# Editor/OS cruft
*.swp
.DS_Store

# HP firmware patch blobs and raw USB traces (HP IP / device dumps) — never commit
captures/*.usblog
captures/*.patch
captures/init_cmds.json
vendor/patches/
captures/skey_dump.json

# Biometric fingerprint images / raw scanline dumps — never commit (privacy)
captures/*.png
captures/*.pgm
captures/lines.raw
captures/perm_*.bin
captures/plaintext_cmds.txt
captures/*.json.secret

# Rust build artifacts
/target

# Device configs dumped from HP trace (structural, per-device) — keep out of the repo
captures/dli_config.json
captures/capture_cmd.json

# Raw capture/pixel dumps (biometric + device data) — never commit
captures/*.bin
captures/capture_seq.json

# HP calibration traces + sweep-frame dumps (device data)
captures/calib_trace*.txt
captures/calib_frames/

# ---- Universal (multi-sensor) layout ----
# Per-model runtime data is ALL HP-derived (firmware patches, the sensor's RSA
# key, the extracted client cert/key, descramble table, command sequences).
# Generate it with tools/ from HP's package; never commit it. The committed
# data/README.md documents the layout.
/data/*/
# HP's proprietary package and anything dropped in to extract from.
/vendor/

# Legacy single-sensor data dir — superseded by data/<model>/; all HP-derived/dev
/captures/

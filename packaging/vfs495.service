[Unit]
Description=Validity fingerprint sensor feeder (open driver -> libfprint virtual_image)
Documentation=https://github.com/hammadmajid/vfs495

[Service]
# Idle until fprintd is waiting for a finger, then capture a swipe and feed it.
# The sensor model (and its calibration/settle defaults) is auto-detected from USB.
ExecStart=/usr/local/bin/vfs495 --base /usr/local/share/vfs495 daemon --fprintd --socket /var/lib/fprint/vfs495.sock
# Set VFS_CUE_LED=capslock to light the Caps Lock LED while the sensor records.
Environment=RUST_LOG=warn,vfs495=info,vfs495::capture=warn,vfs495::session=warn
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
